# Copiá estas variables en Vercel: Project Settings > Environment Variables.
# No pongas valores reales en este archivo ni lo subas con datos reales.

# Supabase (Project Settings > API en tu proyecto de Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (opcional al inicio: sin esto, los mensajes igual se guardan en Supabase,
# solo no llega la notificación por correo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=samuelmonterroso47@gmail.com

# Clave para poder subir capturas de Power BI desde /admin.html
# Generala vos mismo (ej: openssl rand -hex 24) y no la compartas.
ADMIN_SECRET=
